# Supabase — proje ayarlarindaki API sayfasindan
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role anahtari SADECE sunucuda kullanilir, tarayiciya asla gitmez
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dekont okuma Python servisi (FastAPI) — Claude/AI kullanmaz, regex + Tesseract
# OCR ile calisir. Yerelde "npm run dev:full", uretimde VPS'te Docker ile kosar
# (imaj Tesseract'i ve Turkce dil paketini icinde tasir; bkz. README).
# Uretimde bu adres VPS'inizdeki Caddy'yi gosterir: https://dekont.<alanadi>
DEKONT_SERVIS_URL=http://localhost:8000
# ZORUNLU: servis anahtarsiz hicbir istek kabul etmez (fail-closed). Serviste
# ve burada ayni deger olmali. Rastgele uretmek icin: openssl rand -hex 32
DEKONT_SERVICE_KEY=

# Kiraci yukleme linkinin tam adresi (WhatsApp mesajina bu yazilir)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# n8n ileride /api/ingest'e baglanirsa bu anahtari X-Ingest-Key header'inda gonderir
INGEST_API_KEY=

# WAHA (WhatsApp otomasyonu) - bos birakilirsa manuel wa.me akisi devam eder
# Uretimde: https://waha.<alanadi> (VPS'te Caddy arkasinda)
# WAHA_URL doluysa: fatura mesaji elle tiklamadan otomatik gider, kiracinin
# sohbete attigi dekont /api/whatsapp-webhook uzerinden otomatik yakalanir.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# WAHA'nin webhook cagrisinda gonderdigi X-Webhook-Secret ile ayni deger olmali
WAHA_WEBHOOK_SECRET=

# Vadesi gecmis faturalara gunluk otomatik WhatsApp hatirlatmasi gonderen cron
# ucu (/api/cron/hatirlat, zamanlama vercel.json'da). Bos birakilirsa uc nokta
# TUM istekleri reddeder — Vercel'de bu degiskeni mutlaka tanimlayin.
# Rastgele uretmek icin: openssl rand -hex 32
CRON_SECRET=
