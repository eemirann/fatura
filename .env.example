# Bu dosyayi kopyalayip doldurun:  cp .env.example .env
#
# Asagidaki degiskenlerin TAMAMI zorunludur (aksi belirtilenler haric).
# docker-compose.yml bunlari ${DEGISKEN:?...} ile zorunlu kiliyor; biri eksikse
# "docker compose up -d" hata verip hic baslamaz.
#
# Rastgele sir uretmek icin:  openssl rand -hex 32

# ---------------------------------------------------------------- altyapi
# Alan adiniz. Uc alt alan adi bu koke gore uretilir ve UCU DE bu sunucunun
# IP'sine A kaydiyla bakmalidir (Cloudflare kullaniyorsaniz proxy KAPALI /
# "DNS only" olmali, yoksa Caddy sertifika alamaz):
#   panel.<alanadi>   dekont.<alanadi>   waha.<alanadi>
DOMAIN=ornek.com
# Let's Encrypt sertifika uyarilari (yaklasan son kullanma vb.) buraya gider.
ACME_EMAIL=siz@ornek.com

# ---------------------------------------------------------------- Supabase
# Proje ayarlarindaki API sayfasindan alinir.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role anahtari SADECE sunucuda kullanilir, tarayiciya asla gitmez.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------- panel
# Panelin kendi genel adresi — kiraciya giden dekont linki ve Supabase davet
# yonlendirmesi bundan uretilir.
# NOT: "NEXT_PUBLIC_" oneki bilerek yok. Next o onekli degiskenleri derleme
# aninda pakete gomuyor; oneksiz SITE_URL calisma aninda okunur, boylece ayni
# Docker imaji farkli musterilerde farkli alan adiyla calisabiliyor.
# Docker ile calisirken compose bunu "https://panel.${DOMAIN}" olarak kendisi
# uretir; asagidaki deger yalnizca yerel gelistirme icindir.
SITE_URL=http://localhost:3100

# ---------------------------------------------------------- dekont servisi
# Dekont okuma Python servisi (FastAPI) — AI kullanmaz, regex + Tesseract OCR
# ile calisir. Yerelde "npm run dev:full", uretimde Docker ile kosar (imaj
# Tesseract'i ve Turkce dil paketini icinde tasir; bkz. README).
# Docker ile calisirken compose bunu container agindan (http://dekont:8000)
# kendisi verir; asagidaki deger yalnizca yerel gelistirme icindir.
DEKONT_SERVIS_URL=http://localhost:8000
# ZORUNLU: servis anahtarsiz hicbir istek kabul etmez (fail-closed). Serviste
# ve burada ayni deger olmali.
DEKONT_SERVICE_KEY=

# ---------------------------------------------------------------- WhatsApp
# WAHA_URL bos birakilirsa otomasyon kapanir ve manuel wa.me akisi devam eder.
# Doluysa: fatura mesaji elle tiklamadan otomatik gider, kiracinin sohbete
# attigi dekont /api/whatsapp-webhook uzerinden otomatik yakalanir.
# Docker ile calisirken compose varsayilan olarak http://waha:3000 kullanir.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# WAHA'nin webhook cagrisinda gonderdigi X-Webhook-Secret ile ayni deger olmali.
# Bos birakilirsa webhook TUM istekleri reddeder, yani kiracinin sohbete attigi
# dekont sessizce dusmeye baslar.
WAHA_WEBHOOK_SECRET=
# WAHA yonetim panosu (https://waha.<alanadi>/dashboard/) icin basic auth.
# Panoya ayrica WAHA_API_KEY'i de girmeniz gerekir — ikisi farkli seydir.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# -------------------------------------------------------------------- cron
# Vadesi gecmis faturalara otomatik WhatsApp hatirlatmasi gonderen uc
# (/api/cron/hatirlat) bu sirla korunur. Bos birakilirsa uc nokta TUM
# istekleri reddeder.
CRON_SECRET=
# Hatirlatmanin calisma zamani (cron bicimi). Opsiyonel; varsayilan her gun
# 09:00. Container saat dilimi Europe/Istanbul olarak ayarlidir.
CRON_SAATI=0 9 * * *

# --------------------------------------------------------------- yedekleme
# scripts/yedekle.sh kullanir; panel container'i bu degiskenleri gormez.
#
# Veritabani baglanti adresi. Supabase panosu: Project Settings -> Database
# -> Connection string -> URI. Yedek almak icin ZORUNLU.
SUPABASE_DB_URL=
# Yedeklerin yazilacagi dizin ve kac gun saklanacagi (opsiyonel).
YEDEK_DIZINI=/opt/fatura-yedek
YEDEK_SAKLAMA_GUN=14
# Opsiyonel: Healthchecks.io gibi bir "olu adam dugmesi" ucu. Yedek basariyla
# bittiginde ping atilir; yedek hic calismazsa o servis sizi uyarir.
YEDEK_PING_URL=

# ------------------------------------------------------------------ diger
# Opsiyonel: n8n gibi bir arac /api/ingest'e baglanirsa bu anahtari
# X-Ingest-Key header'inda gonderir. Bos birakilabilir.
INGEST_API_KEY=
